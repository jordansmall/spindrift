#!/usr/bin/env bash
# Fake gh for tests. Records every invocation to $GH_LOG and models the pr pair
# tests/fake-gh-pr-ready.bats calls directly:
#
#   * `pr view --json isDraft` reads FAKE_GH_PR_DRAFT_<n>; `pr ready` flips it to
#     false and `pr ready --undo` back to true in $GH_STATE.
#   * Every other call is recorded, no-op.
set -euo pipefail

: "${GH_LOG:?GH_LOG must point at a log file}"
printf '%s\n' "$*" >>"$GH_LOG"

# Per-test state (pr-draft-N -> isDraft), kept beside the log so it is isolated
# per test yet persists across gh calls.
GH_STATE="${GH_STATE:-$GH_LOG.state}"

# state_get KEY: the last value $GH_STATE recorded for KEY, or empty.
state_get() {
  local k v cur=""
  if [ -f "$GH_STATE" ]; then
    while IFS=$'\t' read -r k v; do
      [ "$k" = "$1" ] && cur="$v"
    done <"$GH_STATE"
  fi
  printf '%s' "$cur"
}

case "${1:-}" in
  pr)
    case "${2:-}" in
      view)
        pr_ref="${3:-}"
        json_field=""
        args=("$@")
        for ((i = 0; i < ${#args[@]}; i++)); do
          [ "${args[i]}" = "--json" ] && json_field="${args[i + 1]:-}"
        done
        pr_num="${pr_ref##*/}"
        case "$json_field" in
          isDraft)
            # Dynamic flip written by `gh pr ready` takes precedence.
            dyn_state=$(state_get "pr-draft-$pr_num")
            if [ -n "$dyn_state" ]; then
              printf '%s\n' "$dyn_state"
            else
              draftvar="FAKE_GH_PR_DRAFT_${pr_num}"
              printf '%s\n' "${!draftvar:-false}"
            fi
            ;;
        esac
        ;;
      ready)
        # Models MarkReady (`gh pr ready <prURL>`, flips to non-draft) and
        # MarkDraft (`gh pr ready --undo <prURL>`, flips back to draft). The URL
        # is always the last argument either way, so parse it from there rather
        # than a fixed positional index (issue #2423).
        pr_ref="${*: -1}"
        pr_num="${pr_ref##*/}"
        is_draft=false
        for a in "$@"; do
          [ "$a" = "--undo" ] && is_draft=true
        done
        printf 'pr-draft-%s\t%s\n' "$pr_num" "$is_draft" >>"$GH_STATE"
        ;;
    esac
    ;;
esac

exit 0
