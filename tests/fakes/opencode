#!/usr/bin/env bash
# Stub-agent fake `opencode` for tests. NEVER calls a real LLM.
#
# It records the rendered prompt (the value passed after -p) to
# $DRIVER_PROMPT_FILE and a marker to $DRIVER_LOG. When FAKE_DRIVER_COMMIT=1 it
# also plays the scripted agent: make a change, commit it, push the current
# branch, and open a (faked) PR — exercising the full clone -> branch -> agent
# -> commit -> push -> PR pipeline against a local bare repo.
#
# Mirrors tests/fakes/claude line-for-line in control flow (same env-var
# contract), but emits opencode's real NDJSON transcript shape instead of
# claude's stream-json: every outcome-carrying line is a `{"type":"text",
# "part":{"text":"..."}}` event (the shape lib/drivers/opencode.nix's
# outcomeExtractFnBody parses via `jq -r 'select(.type == "text") |
# .part.text // empty'`, and the shape asserted in
# cmd/launcher/internal/driver/opencode/transcript_test.go's
# TestRenderTranscript_SurfacesTextEvents), not claude's `result` envelope.
set -euo pipefail

: "${DRIVER_LOG:?DRIVER_LOG must point at a log file}"
# Snapshot the call index (0 for this process's first invocation) before this
# invocation appends its own "driver invoked for issue" line below, so
# FAKE_DRIVER_NO_OUTCOME_FIRST_CALL_ONLY can tell first call from resume.
call_index="$(grep -c '^driver invoked for issue' "$DRIVER_LOG" 2>/dev/null || true)"
printf '%s\n' "$*" >>"$DRIVER_LOG"

prompt=""
# shellcheck disable=SC2034 # model is read by the sourced _driver-common.bash below
model=""
while [ $# -gt 0 ]; do
  case "$1" in
    -m)
      # shellcheck disable=SC2034 # model is read by the sourced _driver-common.bash below
      model="${2:-}"
      shift 2
      ;;
    --variant)
      # opencode's real effort flag (lib/drivers/opencode.nix); consumed so
      # it isn't mistaken for the positional prompt below. Nothing
      # downstream reads an effort value yet.
      shift 2
      ;;
    *)
      # opencode's real argv shape has no prompt flag -- the prompt rides a
      # bare positional argument (lib/drivers/opencode.nix's argvShape).
      prompt="$1"
      shift
      ;;
  esac
done

printf '%s' "$prompt" >"${DRIVER_PROMPT_FILE:-/dev/null}"
# Shared control flow (env/skill logging, rebase conflict resolution,
# commit/push/PR pipeline) also played out by tests/fakes/claude; kept in
# one place since it is byte-for-byte identical across Drivers whose fake
# argument parsing differs (opencode never parses --agents, unlike claude).
# shellcheck source=tests/fakes/_driver-common.bash disable=SC1091
source "$(dirname "${BASH_SOURCE[0]}")/_driver-common.bash"

# Emit an opencode-shaped NDJSON transcript to stdout, matching
# `run --format json`: a step_start/text/step_finish sequence per message,
# where every `type:"text"` event's `.part.text` is scanned for the
# SPINDRIFT_OUTCOME line (opencode has no single terminal `result` envelope
# like claude's stream-json). The step_start/step_finish pair around each
# text event is illustrative only -- not load-bearing for the outcome suites,
# which key off the outcome-carrying text event and this process's exit code.
#
# FAKE_DRIVER_NO_OUTCOME=1 simulates a driver that forgot to emit one (issue
# #593's entrypoint backstop): the text event's text carries no
# SPINDRIFT_OUTCOME line at all.
#
# FAKE_DRIVER_NO_OUTCOME_FIRST_CALL_ONLY=1 simulates the same forgetful driver
# only on this fake's first invocation within a test, then emits a real
# outcome on every call after — for exercising the resume-once recovery pass
# (issue #1607), which must see the second (resumed) call succeed.
#
# FAKE_DRIVER_NEAR_MISS=1 simulates a driver that emits a "near-miss" outcome
# line -- the SPINDRIFT_OUTCOME token present as a leading line but missing
# both landing= and status= (issue #1900): parses nowhere, so the entrypoint's
# recovery nudge must quote it back verbatim rather than treat it as absent.
#
# FAKE_DRIVER_NEAR_MISS_FIRST_CALL_ONLY=1 simulates the same only on this
# fake's first invocation within a test, then emits a real outcome on every
# call after — for exercising the resume-once recovery pass's near-miss-aware
# prompt (issue #1900), mirroring FAKE_DRIVER_NO_OUTCOME_FIRST_CALL_ONLY above.
#
# FAKE_DRIVER_WRAP_OUTCOME selects a markdown-wrapped outcome line (issue
# #1611's #1582 repro): a text event's text sometimes wraps the line in
# inline backticks, bold markers, or pads it with whitespace, so the
# entrypoint's extractor must tolerate it.
#
# FAKE_DRIVER_MULTI_RESULT=1 emits a stale text event with its own outcome
# line before the real one, simulating a multi-turn transcript with more than
# one outcome-carrying text event -- the extractor's tail -1 semantics must
# keep picking the last outcome line, not the first.
#
# A well-behaved agent prints SPINDRIFT_PR_INTENT immediately before its
# final SPINDRIFT_OUTCOME line (issue #1919), so the default text event
# below carries one too -- otherwise every existing read-only+status=ready
# fixture in this suite would spuriously trip the PR-intent required-marker
# gate row (issue #2045) and eat its second (resumed) invocation's own
# rendered prompt.
#
# FAKE_DRIVER_NO_PR_INTENT=1 simulates a driver that forgot the PR-intent
# line (issue #2036) -- the scenario that gate exists to nudge past.
#
# FAKE_DRIVER_NO_PR_INTENT_FIRST_CALL_ONLY=1 simulates the same only on this
# fake's first invocation within a test, then emits a real one on every call
# after -- for exercising the gate's resume-once recovery pass, mirroring
# FAKE_DRIVER_NO_OUTCOME_FIRST_CALL_ONLY above.
pr_intent_line=""
if [ "${FAKE_DRIVER_NO_PR_INTENT:-0}" != "1" ] && \
   { [ "${FAKE_DRIVER_NO_PR_INTENT_FIRST_CALL_ONLY:-0}" != "1" ] || [ "${call_index:-0}" != "0" ]; }; then
  pr_intent_payload="$(printf 'feat: fake title\n\nfake body' | base64 -w0)"
  # The trailing \\n\\n are literal two-char backslash-n escapes, JSON's own
  # newline encoding within the "text" string value below -- not real
  # newlines -- matching the blank-line separator the real grammar puts
  # between the PR-intent line and the SPINDRIFT_OUTCOME line after it.
  pr_intent_line="$(printf 'SPINDRIFT_PR_INTENT %s %s\\n\\n' "${RUN_NONCE:-fake-nonce}" "$pr_intent_payload")"
fi
printf '{"type":"step_start","part":{"messageID":"msg_1"}}\n'
printf '{"type":"text","part":{"text":"implementing #%s"}}\n' "${ISSUE_NUMBER:-0}"
printf '{"type":"step_finish","part":{"messageID":"msg_1","modelID":"fake-model","tokens":{"input":10,"output":5,"reasoning":0,"cache":{"write":0,"read":0}},"cost":0.001}}\n'
if [ "${FAKE_DRIVER_MULTI_RESULT:-0}" = "1" ]; then
  printf '{"type":"text","part":{"text":"SPINDRIFT_OUTCOME issue=%s landing=https://github.com/%s/pull/0 status=blocked note=stale"}}\n' \
    "${ISSUE_NUMBER:-0}" "${REPO_SLUG:-owner/repo}"
fi
printf '{"type":"step_start","part":{"messageID":"msg_2"}}\n'
if [ "${FAKE_DRIVER_NEAR_MISS:-0}" = "1" ] || { [ "${FAKE_DRIVER_NEAR_MISS_FIRST_CALL_ONLY:-0}" = "1" ] && [ "${call_index:-0}" = "0" ]; }; then
  # A line that leads with the SPINDRIFT_OUTCOME token but carries no
  # landing=/status= fields (issue #1900): parses nowhere, so it is a
  # near-miss the recovery nudge must quote back, not a valid outcome.
  printf '{"type":"text","part":{"text":"SPINDRIFT_OUTCOME: SUCCESS"}}\n'
elif [ "${FAKE_DRIVER_NO_OUTCOME:-0}" = "1" ] || { [ "${FAKE_DRIVER_NO_OUTCOME_FIRST_CALL_ONLY:-0}" = "1" ] && [ "${call_index:-0}" = "0" ]; }; then
  printf '{"type":"text","part":{"text":"done, but forgot to report back"}}\n'
else
  case "${FAKE_DRIVER_WRAP_OUTCOME:-}" in
    backticks)
      # The backticks are literal chars in the printf format string,
      # simulating markdown wrapping, not unexpanded command substitution.
      # shellcheck disable=SC2016
      printf '{"type":"text","part":{"text":"CI registered.\\n\\n`SPINDRIFT_OUTCOME issue=%s landing=https://github.com/%s/pull/1 status=ready note=fake`"}}\n' \
        "${ISSUE_NUMBER:-0}" "${REPO_SLUG:-owner/repo}"
      ;;
    bold)
      printf '{"type":"text","part":{"text":"**SPINDRIFT_OUTCOME issue=%s landing=https://github.com/%s/pull/1 status=ready note=fake**"}}\n' \
        "${ISSUE_NUMBER:-0}" "${REPO_SLUG:-owner/repo}"
      ;;
    whitespace)
      printf '{"type":"text","part":{"text":"   SPINDRIFT_OUTCOME issue=%s landing=https://github.com/%s/pull/1 status=ready note=fake   "}}\n' \
        "${ISSUE_NUMBER:-0}" "${REPO_SLUG:-owner/repo}"
      ;;
    colon)
      # A well-formed key=value line, but with the delimiter after the token
      # mis-typed as a colon instead of the required space (issue #2012) --
      # still machine-recoverable, unlike the "prose" case below.
      printf '{"type":"text","part":{"text":"SPINDRIFT_OUTCOME: issue=%s landing=https://github.com/%s/pull/1 status=ready note=fake"}}\n' \
        "${ISSUE_NUMBER:-0}" "${REPO_SLUG:-owner/repo}"
      ;;
    prose)
      # A colon-prefixed sign-off with no issue=/landing=/status= fields at
      # all (the #1998 dogfood shape, issue #2012) -- genuinely not
      # machine-recoverable, so the extractor must leave it unmatched rather
      # than guess a status from the prose.
      printf '{"type":"text","part":{"text":"SPINDRIFT_OUTCOME: Complete \xe2\x80\x94 implemented issue #%s"}}\n' \
        "${ISSUE_NUMBER:-0}"
      ;;
    stray-field)
      # A colon-prefixed prose sign-off that happens to contain one stray
      # field marker mid-sentence, with no landing= alongside it (issue
      # #2012) -- still not a genuine key=value line, so the extractor's
      # field check must require landing= and status= together, not just any
      # one of the three markers appearing anywhere.
      printf '{"type":"text","part":{"text":"SPINDRIFT_OUTCOME: I think status=done for issue #%s"}}\n' \
        "${ISSUE_NUMBER:-0}"
      ;;
    *)
      # FAKE_DRIVER_OUTCOME_STATUS overrides the status field (default
      # "ready") -- e.g. exercising the PR-intent required-marker gate row
      # (issue #2045), which must fire only on status=ready and never on a
      # blocked run.
      printf '{"type":"text","part":{"text":"%sSPINDRIFT_OUTCOME issue=%s landing=https://github.com/%s/pull/1 status=%s note=fake"}}\n' \
        "$pr_intent_line" "${ISSUE_NUMBER:-0}" "${REPO_SLUG:-owner/repo}" "${FAKE_DRIVER_OUTCOME_STATUS:-ready}"
      ;;
  esac
fi
printf '{"type":"step_finish","part":{"messageID":"msg_2","modelID":"fake-model","tokens":{"input":10,"output":5,"reasoning":0,"cache":{"write":0,"read":0}},"cost":0.001}}\n'

# FAKE_DRIVER_CRASH_EXIT simulates a driver killed by a transient
# infrastructure failure (rate limit, overload, network blip) with no outcome
# line: the launcher's own ClassifyTransient/retry path -- not the
# entrypoint's outcome backstop -- owns this case (issue #593), so the
# entrypoint must propagate this exit code untouched.
if [ -n "${FAKE_DRIVER_CRASH_EXIT:-}" ]; then
  exit "$FAKE_DRIVER_CRASH_EXIT"
fi

exit 0
