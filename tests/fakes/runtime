#!/usr/bin/env bash
# Podman fake: records every invocation to $PODMAN_LOG and answers the image
# and container probes tests/harness-env.bats drives `spindrift dispatch`
# through. tests/helper.bash stages it as `podman`.
set -euo pipefail

log="${PODMAN_LOG:?}"

# Appends one record to $1 as a single write(). A bash `printf >>file` flushes
# through stdio in buffer-sized chunks, so a long `podman run` argv from one
# concurrent invocation can land mid-line inside another's. `cat` is no fix
# (its buffer is bounded and can be smaller than a long record); `dd` with a
# large bs reads the whole here-string and writes it back in one O_APPEND
# write. That holds for records up to bs (1 MiB); longer ones would split.
_append() {
  dd of="$1" oflag=append conv=notrunc bs=1M iflag=fullblock status=none <<<"$2"
}

_append "$log" "$*"

case "${1:-}" in
  image)
    if [ "${2:-}" = "inspect" ] || [ "${2:-}" = "exists" ]; then
      [ "${FAKE_PODMAN_IMAGE_PRESENT:-0}" = "1" ]
      exit $?
    fi
    ;;
  inspect)
    # Container liveness probe: no container ever exists.
    exit 1
    ;;
esac

exit 0
