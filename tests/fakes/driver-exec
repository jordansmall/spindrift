#!/usr/bin/env bash
# Fake driver-exec for bats tests (issue #626). Stands in for the real in-box
# Go binary closely enough to prove agent/entrypoint.sh wires it correctly:
# takes a single --handoff-file (issue #2975) and reads the driver bin, argv
# shape, model/effort (role-aware via --top-level-role), devshell, heartbeat,
# and roster off that JSON document -- exactly the fields
# cmd/launcher/driver-exec/main.go reads via promptassembly.LoadHandoffFile --
# plus the surviving --prompt-file/--session-file/--log-path flags. Builds the
# Driver's argv from the handoff's ArgvShape (mirroring
# cmd/launcher/driver-exec/args.go's slot-walk rather than hardcoding one
# Driver's shape), runs it directly or -- when the handoff's Devshell is set --
# wrapped in `nix develop --command`, writes its raw output to -log-path (and
# echoes it to stdout, the launcher's byte-exact capture channel), and appends
# a synthetic heartbeat line to the handoff's HeartbeatLog (absorbing the
# former standalone spindrift-heartbeat-filter fake). The real binary's own devShell-wrapping,
# exit-code propagation, stream-teeing, heartbeat-filtering, and
# relaunch-on-empty-stream logic are covered by Go unit tests
# (cmd/launcher/driver-exec), not this fake.
#
# The `bundle-out` verb (issue #1808) is a second, unrelated entry point --
# real git plumbing, not a Driver invocation -- so it is dispatched off a
# bare first arg before the flag loop below ever runs. The `outcome-backstop`
# verb (issue #2157) is a third such entry point, dispatched the same way.
# The `assemble-prompt` verb (issue #2354) is a fourth: unlike the other two,
# it delegates straight to the real Go binary (DRIVER_EXEC_BIN, exported by
# the nix bats derivation, nix/checks/bats.nix) instead of reimplementing its
# gate logic here -- promptassembly is the source of truth and this fake has
# no bash re-derivation to keep in lockstep with it. The `marker-gate` verb
# (issue #2511) is a fifth, delegated the same way. The `readonly-guards`
# verb (issue #2509) is a sixth, delegated the same way as assemble-prompt --
# readonlyguards is the source of truth for the guards' rendered content. The
# `bind-registry` verb (issue #2930) is a seventh, delegated the same way --
# bindregistry is the source of truth for the ecosystem classification. The
# `env-handoff` verb (issue #2975 slice 3) is an eighth, delegated the same
# way -- promptassembly.Handoff is the source of truth for the Handoff/
# ArgvShape/Caps grammar it emits, not a bash re-derivation of that shape.
set -euo pipefail

if [ "${1:-}" = "assemble-prompt" ]; then
  shift
  exec "$DRIVER_EXEC_BIN" assemble-prompt "$@"
fi

if [ "${1:-}" = "marker-gate" ]; then
  shift
  exec "$DRIVER_EXEC_BIN" marker-gate "$@"
fi

if [ "${1:-}" = "readonly-guards" ]; then
  shift
  exec "$DRIVER_EXEC_BIN" readonly-guards "$@"
fi

if [ "${1:-}" = "bind-registry" ]; then
  shift
  exec "$DRIVER_EXEC_BIN" bind-registry "$@"
fi

if [ "${1:-}" = "env-handoff" ]; then
  shift
  exec "$DRIVER_EXEC_BIN" env-handoff "$@"
fi

if [ "${1:-}" = "bundle-out" ]; then
  shift
  repo="" base="" branch="" outbox="" bundle_issue="" prior=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --repo) repo="$2"; shift 2 ;;
      --base) base="$2"; shift 2 ;;
      --branch) branch="$2"; shift 2 ;;
      --outbox) outbox="$2"; shift 2 ;;
      --issue) bundle_issue="$2"; shift 2 ;;
      --prior-outcome-line) prior="$2"; shift 2 ;;
      *) shift ;;
    esac
  done
  count="$(git -C "$repo" rev-list --count "$base..$branch")"
  if [ "$count" -gt 0 ]; then
    mkdir -p "$outbox"
    git -C "$repo" bundle create "$outbox/seam.bundle" "$base..$branch" >/dev/null
  elif [[ "$prior" == *"status=ready"* ]]; then
    printf 'SPINDRIFT_OUTCOME issue=%s landing=none status=blocked note=agent reported ready but no commits exist on %s\n' \
      "$bundle_issue" "$branch"
  fi
  exit 0
fi

if [ "${1:-}" = "outcome-backstop" ]; then
  # This branch re-implements the decision tree that the real verb owns in
  # cmd/launcher/internal/outcomebackstop (Config resolution, salvage,
  # commit-count / forge / write-enabled branching, push-with-retry). It is a
  # stand-in for the bats wiring tests only -- the Go package is the
  # source-of-truth. Keep the two in lockstep: any change to the verb's
  # decisions belongs here too, and vice versa.
  shift
  repo="" ob_issue="" branch="" base="" kind="work"
  host_mediated_remote="" outbox_relay_capable=""
  write="" nonce="" recovery="" attempts="1" backoff="0" jitter="0"
  while [ $# -gt 0 ]; do
    case "$1" in
      --repo) repo="$2"; shift 2 ;;
      --issue) ob_issue="$2"; shift 2 ;;
      --branch) branch="$2"; shift 2 ;;
      --base) base="$2"; shift 2 ;;
      --dispatch-kind) kind="$2"; shift 2 ;;
      --host-mediated-remote) host_mediated_remote="$2"; shift 2 ;;
      --outbox-relay-capable) outbox_relay_capable="$2"; shift 2 ;;
      --box-write-enabled) write="$2"; shift 2 ;;
      --nonce) nonce="$2"; shift 2 ;;
      --recovery-attempted) recovery="$2"; shift 2 ;;
      --max-attempts) attempts="$2"; shift 2 ;;
      --backoff-secs) backoff="$2"; shift 2 ;;
      --jitter-secs) jitter="$2"; shift 2 ;;
      *) shift ;;
    esac
  done
  # Run every git call from inside the repo, not via `git -C`: the bats
  # push shims match on `$1 = push`, so a leading `-C <repo>` would slip the
  # force-push past them. The real Go verb uses `git -C` -- there is no shim
  # in production. (issue #2157)
  cd "$repo"
  note="driver exited without emitting an outcome"
  [ -n "$recovery" ] && note="${note}; a resume attempt also produced no outcome"
  if [ "$kind" = "research" ]; then
    printf 'SPINDRIFT_OUTCOME issue=%s landing=none status=blocked note=%s nonce=%s\n' \
      "$ob_issue" "$note" "$nonce"
    exit 0
  fi
  status="blocked"
  if [ -n "$(git status --porcelain 2>/dev/null)" ]; then
    if git add -A && git commit -m "chore: salvage uncommitted work before exiting without an outcome" >/dev/null 2>&1; then
      note="${note}; salvaged uncommitted work into a commit"
    else
      note="${note}; failed to salvage uncommitted work"
      printf 'SPINDRIFT_OUTCOME issue=%s landing=%s status=%s note=%s nonce=%s\n' \
        "$ob_issue" "$branch" "$status" "$note" "$nonce"
      exit 0
    fi
  fi
  commit_count="$(git rev-list --count "$base..$branch" 2>/dev/null)" || commit_count=1
  if [ "$commit_count" -eq 0 ]; then
    note="${note}; no work to preserve"
  elif [ -n "$host_mediated_remote" ]; then
    note="${note}; branch relayed via outbox bundle (no writable remote under CODE_FORGE=local)"
    status="ready"
  elif [ -z "$write" ] && [ -n "$outbox_relay_capable" ]; then
    note="${note}; branch relayed via outbox bundle (read-only Box)"
    status="ready"
  else
    [ "$attempts" -lt 1 ] && attempts=1
    [ "$backoff" -lt 0 ] && backoff=0
    [ "$jitter" -lt 0 ] && jitter=0
    push_log="$(mktemp)"
    attempt=1
    pushed=""
    while true; do
      if git push --force-with-lease origin "$branch" 2>"$push_log"; then
        pushed=1
        break
      fi
      if [ "$attempt" -ge "$attempts" ]; then
        note="${note}; push failed after ${attempt} attempt(s): $(tail -1 "$push_log")"
        break
      fi
      sleep "$(( backoff * attempt + jitter ))"
      attempt=$(( attempt + 1 ))
    done
    rm -f "$push_log"
    [ -n "$pushed" ] && status="ready"
  fi
  printf 'SPINDRIFT_OUTCOME issue=%s landing=%s status=%s note=%s nonce=%s\n' \
    "$ob_issue" "$branch" "$status" "$note" "$nonce"
  exit 0
fi

# The default (Driver-invocation) verb now takes a single --handoff-file
# (issue #2975): every driver/model/effort/argv-shape/devshell/heartbeat/roster
# fact the real Go binary once took as ~20 individual flags now lives inside
# that JSON document, read here via jq exactly as cmd/launcher/driver-exec/
# main.go reads it off promptassembly.LoadHandoffFile. Only --prompt-file
# (optional, falling back to the handoff's PromptFile), --session-file,
# --log-path, and --top-level-role stay real flags -- mirroring main.go's own
# surviving flag set.
handoff_file="" prompt_file="" session_file="" log_path="" top_level_role=""
while [ $# -gt 0 ]; do
  case "$1" in
    --handoff-file) handoff_file="$2"; shift 2 ;;
    --prompt-file) prompt_file="$2"; shift 2 ;;
    --session-file) session_file="$2"; shift 2 ;;
    --log-path) log_path="$2"; shift 2 ;;
    --top-level-role) top_level_role="$2"; shift 2 ;;
    *) shift ;;
  esac
done

# Every remaining input is read off the handoff document, the same fields
# assembleprompt_cmd.go wrote and main.go reads back.
driver_bin="$(jq -r '.DriverBin // ""' "$handoff_file")"
driver_flags="$(jq -r '.DriverFlags // ""' "$handoff_file")"
issue="$(jq -r '.Issue // ""' "$handoff_file")"
[ -n "$issue" ] || issue="${ISSUE_NUMBER:-0}"
devshell_name="$(jq -r '.DevshellName // "default"' "$handoff_file")"
[ "$(jq -r '.Devshell // false' "$handoff_file")" = "true" ] && devshell=1 || devshell=0
heartbeat_log="$(jq -r '.HeartbeatLog // ""' "$handoff_file")"
[ -n "$heartbeat_log" ] || heartbeat_log="/tmp/heartbeat.log"
agents_file="$(jq -r '.AgentsFile // ""' "$handoff_file")"
argv_prompt_style="$(jq -r '.ArgvShape.PromptStyle // "flag"' "$handoff_file")"
argv_prompt_flag="$(jq -r '.ArgvShape.PromptFlag // ""' "$handoff_file")"
argv_model_flag="$(jq -r '.ArgvShape.ModelFlag // "--model"' "$handoff_file")"
[ "$(jq -r '.ArgvShape.ModelOmitEmpty // false' "$handoff_file")" = "true" ] && argv_model_omit_empty=1 || argv_model_omit_empty=0
argv_agents_flag="$(jq -r '.ArgvShape.AgentsFlag // ""' "$handoff_file")"
argv_effort_flag="$(jq -r '.ArgvShape.EffortFlag // "--effort"' "$handoff_file")"
argv_order="$(jq -r '.ArgvShape.Order // [] | join(" ")' "$handoff_file")"

# Role-aware model/effort resolution, mirroring main.go exactly: a reviewer
# pass overrides only the fields the handoff's ReviewModel/ReviewEffort
# actually carry, leaving the implementor's own Model/Effort as the fallback.
model="$(jq -r '.Model // ""' "$handoff_file")"
effort="$(jq -r '.Effort // ""' "$handoff_file")"
if [ "$top_level_role" = "reviewer" ]; then
  review_model="$(jq -r '.ReviewModel // ""' "$handoff_file")"
  review_effort="$(jq -r '.ReviewEffort // ""' "$handoff_file")"
  [ -n "$review_model" ] && model="$review_model"
  [ -n "$review_effort" ] && effort="$review_effort"
fi

# --prompt-file is optional now, falling back to the handoff's own PromptFile
# (main.go's `if *promptFile == "" { *promptFile = handoff.PromptFile }`).
if [ -z "$prompt_file" ]; then
  prompt_file="$(jq -r '.PromptFile // ""' "$handoff_file")"
fi

# Generic re-implementation of buildDriverArgs's slot-walk
# (cmd/launcher/driver-exec/args.go), driven entirely by the --argv-* shape
# flags above instead of a hardcoded Driver-specific argv (issue #2534): a
# bug in a real Driver's argvShape data row (lib/drivers/*.nix) or in
# args.go's slot handling must be reachable through this fake, not masked by
# it always emitting claude's shape.
args=()
for slot in $argv_order; do
  case "$slot" in
    prompt)
      if [ "$argv_prompt_style" = "flag" ]; then
        args+=("$argv_prompt_flag" "$(cat "$prompt_file")")
      else
        args+=("$(cat "$prompt_file")")
      fi
      ;;
    model)
      if [ -n "$model" ] || [ "$argv_model_omit_empty" != "1" ]; then
        args+=("$argv_model_flag" "$model")
      fi
      ;;
    agents)
      if [ -n "$argv_agents_flag" ] && [ -s "$agents_file" ]; then
        args+=("$argv_agents_flag" "$(cat "$agents_file")")
      fi
      ;;
    session)
      if [ -n "$session_file" ] && [ -s "$session_file" ]; then
        # `read` returns non-zero on a file with no trailing newline
        # (session_file is written with a bare printf '%s', never one) even
        # though it still populates the array correctly -- swallow that
        # under set -e.
        read -ra _session_args < "$session_file" || true
        args+=("${_session_args[@]}")
      fi
      ;;
    driverFlags)
      if [ -n "$driver_flags" ]; then
        read -ra _flag_args <<< "$driver_flags"
        args+=("${_flag_args[@]}")
      fi
      ;;
    effort)
      if [ -n "$effort" ]; then
        args+=("$argv_effort_flag" "$effort")
      fi
      ;;
  esac
done

rc=0
if [ "$devshell" = "1" ]; then
  nix develop ".#$devshell_name" --command "$driver_bin" "${args[@]}" >"$log_path" || rc=$?
else
  "$driver_bin" "${args[@]}" >"$log_path" || rc=$?
fi

cat "$log_path"
printf '#%s · fake heartbeat\n' "$issue" >>"$heartbeat_log"
exit "$rc"
