#!/usr/bin/env bash
# Fake driver-exec for bats tests (issue #626). Stands in for the real in-box
# Go binary closely enough to prove agent/entrypoint.sh wires it correctly:
# reads the prompt/agents/session file paths, builds the Driver's argv, runs
# it directly or -- when --devshell is set -- wrapped in
# `nix develop --command`, writes its raw output to -log-path (and echoes it
# to stdout, the launcher's byte-exact capture channel), and appends a
# synthetic heartbeat line to -heartbeat-log (absorbing the former standalone
# spindrift-heartbeat-filter fake). The real binary's own devShell-wrapping,
# exit-code propagation, stream-teeing, heartbeat-filtering, and
# relaunch-on-empty-stream logic are covered by Go unit tests
# (cmd/launcher/driver-exec), not this fake.
#
# The `bundle-out` verb (issue #1808) is a second, unrelated entry point --
# real git plumbing, not a Driver invocation -- so it is dispatched off a
# bare first arg before the flag loop below ever runs. The `outcome-backstop`
# verb (issue #2157) is a third such entry point, dispatched the same way.
set -euo pipefail

if [ "${1:-}" = "bundle-out" ]; then
  shift
  repo="" base="" branch="" outbox="" bundle_issue="" prior=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --repo) repo="$2"; shift 2 ;;
      --base) base="$2"; shift 2 ;;
      --branch) branch="$2"; shift 2 ;;
      --outbox) outbox="$2"; shift 2 ;;
      --issue) bundle_issue="$2"; shift 2 ;;
      --prior-outcome-line) prior="$2"; shift 2 ;;
      *) shift ;;
    esac
  done
  count="$(git -C "$repo" rev-list --count "$base..$branch")"
  if [ "$count" -gt 0 ]; then
    mkdir -p "$outbox"
    git -C "$repo" bundle create "$outbox/seam.bundle" "$base..$branch" >/dev/null
  elif [[ "$prior" == *"status=ready"* ]]; then
    printf 'SPINDRIFT_OUTCOME issue=%s landing=none status=blocked note=agent reported ready but no commits exist on %s\n' \
      "$bundle_issue" "$branch"
  fi
  exit 0
fi

if [ "${1:-}" = "outcome-backstop" ]; then
  shift
  repo="" ob_issue="" branch="" base="" kind="work" forge="github"
  write="" nonce="" recovery="" attempts="1" backoff="0" jitter="0"
  while [ $# -gt 0 ]; do
    case "$1" in
      --repo) repo="$2"; shift 2 ;;
      --issue) ob_issue="$2"; shift 2 ;;
      --branch) branch="$2"; shift 2 ;;
      --base) base="$2"; shift 2 ;;
      --dispatch-kind) kind="$2"; shift 2 ;;
      --code-forge) forge="$2"; shift 2 ;;
      --box-write-enabled) write="$2"; shift 2 ;;
      --nonce) nonce="$2"; shift 2 ;;
      --recovery-attempted) recovery="$2"; shift 2 ;;
      --max-attempts) attempts="$2"; shift 2 ;;
      --backoff-secs) backoff="$2"; shift 2 ;;
      --jitter-secs) jitter="$2"; shift 2 ;;
      *) shift ;;
    esac
  done
  # Run every git call from inside the repo, not via `git -C`: the bats
  # push shims match on `$1 = push`, so a leading `-C <repo>` would slip the
  # force-push past them. The real Go verb uses `git -C` -- there is no shim
  # in production. (issue #2157)
  cd "$repo"
  note="driver exited without emitting an outcome"
  [ -n "$recovery" ] && note="${note}; a resume attempt also produced no outcome"
  if [ "$kind" = "research" ]; then
    printf 'SPINDRIFT_OUTCOME issue=%s landing=none status=blocked note=%s nonce=%s\n' \
      "$ob_issue" "$note" "$nonce"
    exit 0
  fi
  if [ -n "$(git status --porcelain 2>/dev/null)" ]; then
    if git add -A && git commit -m "chore: salvage uncommitted work before exiting without an outcome" >/dev/null 2>&1; then
      note="${note}; salvaged uncommitted work into a commit"
    else
      note="${note}; failed to salvage uncommitted work"
    fi
  fi
  commit_count="$(git rev-list --count "$base..$branch" 2>/dev/null)" || commit_count=1
  if [ "$commit_count" -eq 0 ]; then
    note="${note}; no work to preserve"
  elif [ "$forge" = "local" ]; then
    note="${note}; no bundle was ever emitted (no writable remote under CODE_FORGE=local)"
  elif [ -z "$write" ] && [ "$forge" = "github" ]; then
    note="${note}; branch relayed via outbox bundle (read-only Box)"
  else
    [ "$attempts" -lt 1 ] && attempts=1
    [ "$backoff" -lt 0 ] && backoff=0
    [ "$jitter" -lt 0 ] && jitter=0
    push_log="$(mktemp)"
    attempt=1
    while true; do
      if git push --force-with-lease origin "$branch" 2>"$push_log"; then
        break
      fi
      if [ "$attempt" -ge "$attempts" ]; then
        note="${note}; push failed after ${attempt} attempt(s): $(tail -1 "$push_log")"
        break
      fi
      sleep "$(( backoff * attempt + jitter ))"
      attempt=$(( attempt + 1 ))
    done
    rm -f "$push_log"
  fi
  printf 'SPINDRIFT_OUTCOME issue=%s landing=%s status=blocked note=%s nonce=%s\n' \
    "$ob_issue" "$branch" "$note" "$nonce"
  exit 0
fi

prompt_file="" agents_file="" session_file=""
driver_bin="" driver_flags="" model="" issue="${ISSUE_NUMBER:-0}"
devshell=0 devshell_name="default" log_path="" heartbeat_log="/tmp/heartbeat.log"

while [ $# -gt 0 ]; do
  case "$1" in
    --prompt-file) prompt_file="$2"; shift 2 ;;
    --agents-file) agents_file="$2"; shift 2 ;;
    --session-file) session_file="$2"; shift 2 ;;
    --driver-bin) driver_bin="$2"; shift 2 ;;
    --driver-flags) driver_flags="$2"; shift 2 ;;
    --model) model="$2"; shift 2 ;;
    --devshell) devshell=1; shift ;;
    --devshell-name) devshell_name="$2"; shift 2 ;;
    --issue) issue="$2"; shift 2 ;;
    --log-path) log_path="$2"; shift 2 ;;
    --heartbeat-log) heartbeat_log="$2"; shift 2 ;;
    *) shift ;;
  esac
done

args=(-p "$(cat "$prompt_file")" --model "$model")
if [ -s "$agents_file" ]; then
  args+=(--agents "$(cat "$agents_file")")
fi
if [ -n "$session_file" ] && [ -s "$session_file" ]; then
  # `read` returns non-zero on a file with no trailing newline (session_file
  # is written with a bare printf '%s', never one) even though it still
  # populates the array correctly -- swallow that under set -e.
  read -ra _session_args < "$session_file" || true
  args+=("${_session_args[@]}")
fi
if [ -n "$driver_flags" ]; then
  read -ra _flag_args <<< "$driver_flags"
  args+=("${_flag_args[@]}")
fi

rc=0
if [ "$devshell" = "1" ]; then
  nix develop ".#$devshell_name" --command "$driver_bin" "${args[@]}" >"$log_path" || rc=$?
else
  "$driver_bin" "${args[@]}" >"$log_path" || rc=$?
fi

cat "$log_path"
printf '#%s · fake heartbeat\n' "$issue" >>"$heartbeat_log"
exit "$rc"
