# Copy to harness.env (gitignored) and fill in — or export these in your shell.
# Secrets only: every other knob is set via the Consumer flake's `settings`
# or an explicit CLI flag (see docs/reference.md and docs/flake-options.md).
#
# Sourcing every secret below from an external vault via its <NAME>_CMD form
# (rbw, op, pass, vault, ...) is the preferred, highly encouraged way to
# supply secrets — see each entry's comment below and docs/reference.md's
# Runtime configuration section. harness.env then holds fetch recipes, not
# live credentials.
#
# One vault under a uniform naming scheme? SECRET_CMD (or --secret-cmd) sets a
# single templated fetch command for every secret below that has no <NAME>_CMD
# of its own — {name} substitutes the secret's kebab-case env name, e.g.
# SECRET_CMD="rbw get spindrift-{name}" reproduces every per-secret example
# below in one line. A per-secret <NAME>_CMD still wins over this fallback.

# Anthropic API key; set this or CLAUDE_CODE_OAUTH_TOKEN. It is also the pi Driver's anthropic Provider key, required when DRIVER=pi and any model tier is anthropic/<model>
# Preferred: fetch this from a vault instead of the plaintext value below —
# ANTHROPIC_API_KEY_CMD="rbw get spindrift-anthropic-api-key" (or an op/pass/vault
# read); the command's stdout wins over ANTHROPIC_API_KEY and is never baked,
# logged, or written to disk.
ANTHROPIC_API_KEY=

# opt-in two-actor separation (ADR 0016 analog): a second machine user's Forgejo PAT for the Box only — the launcher keeps using its own FORGEJO_TOKEN for merges, labels, and all host-side forge calls, while the Box receives this value as its FORGEJO_TOKEN instead; empty (default) leaves the single-token flow unchanged. Pair with a Forgejo branch-protection rule that bars this user from updating the base branch and whitelists only the launcher's user for push and merge — see docs/reference.md's Forgejo two-actor separation recipe
# Preferred: fetch this from a vault instead of the plaintext value below —
# BOX_FORGEJO_TOKEN_CMD="rbw get spindrift-box-forgejo-token" (or an op/pass/vault
# read); the command's stdout wins over BOX_FORGEJO_TOKEN and is never baked,
# logged, or written to disk.
BOX_FORGEJO_TOKEN=

# opt-in two-actor separation (ADR 0016): a second machine user's fine-grained PAT for the Box only — the launcher keeps using its own GH_TOKEN for merges, labels, and all host-side forge calls, while the Box receives this value as its GH_TOKEN instead; empty (default) leaves the single-token flow unchanged. Pair with a repository ruleset that bars this user from updating the base branch and bypass-lists only the launcher's user — see docs/reference.md's two-actor separation recipe
# Preferred: fetch this from a vault instead of the plaintext value below —
# BOX_GH_TOKEN_CMD="rbw get spindrift-box-gh-token" (or an op/pass/vault
# read); the command's stdout wins over BOX_GH_TOKEN and is never baked,
# logged, or written to disk.
BOX_GH_TOKEN=

# Claude Code OAuth token (run 'claude setup-token'); set this or ANTHROPIC_API_KEY
# Preferred: fetch this from a vault instead of the plaintext value below —
# CLAUDE_CODE_OAUTH_TOKEN_CMD="rbw get spindrift-claude-code-oauth-token" (or an op/pass/vault
# read); the command's stdout wins over CLAUDE_CODE_OAUTH_TOKEN and is never baked,
# logged, or written to disk.
CLAUDE_CODE_OAUTH_TOKEN=

# DeepSeek API key for the pi Driver's deepseek Provider; required when DRIVER=pi and any model tier is deepseek/<model>; forwarded into every Box when set, whatever the Driver
# Preferred: fetch this from a vault instead of the plaintext value below —
# DEEPSEEK_API_KEY_CMD="rbw get spindrift-deepseek-api-key" (or an op/pass/vault
# read); the command's stdout wins over DEEPSEEK_API_KEY and is never baked,
# logged, or written to disk.
DEEPSEEK_API_KEY=

# Forgejo/Gitea API token (Bearer/token scheme); required when ISSUE_TRACKER=forgejo or CODE_FORGE=forgejo
# Preferred: fetch this from a vault instead of the plaintext value below —
# FORGEJO_TOKEN_CMD="rbw get spindrift-forgejo-token" (or an op/pass/vault
# read); the command's stdout wins over FORGEJO_TOKEN and is never baked,
# logged, or written to disk.
FORGEJO_TOKEN=

# Google API key for the pi Driver's google Provider; required when DRIVER=pi and any model tier is google/<model>; forwarded into every Box when set, whatever the Driver
# Preferred: fetch this from a vault instead of the plaintext value below —
# GEMINI_API_KEY_CMD="rbw get spindrift-gemini-api-key" (or an op/pass/vault
# read); the command's stdout wins over GEMINI_API_KEY and is never baked,
# logged, or written to disk.
GEMINI_API_KEY=

# fine-grained PAT scoped to the target repo — Contents/PR/Issues/Metadata RW; required unless CODE_FORGE is local or forgejo, and ISSUE_TRACKER is not github
# Preferred: fetch this from a vault instead of the plaintext value below —
# GH_TOKEN_CMD="rbw get spindrift-gh-token" (or an op/pass/vault
# read); the command's stdout wins over GH_TOKEN and is never baked,
# logged, or written to disk.
GH_TOKEN=

# Groq API key for the pi Driver's groq Provider; required when DRIVER=pi and any model tier is groq/<model>; forwarded into every Box when set, whatever the Driver
# Preferred: fetch this from a vault instead of the plaintext value below —
# GROQ_API_KEY_CMD="rbw get spindrift-groq-api-key" (or an op/pass/vault
# read); the command's stdout wins over GROQ_API_KEY and is never baked,
# logged, or written to disk.
GROQ_API_KEY=

# Jira API token (Cloud: paired with JIRA_EMAIL for Basic auth; Server/Data Center: used alone as a Bearer PAT); required when ISSUE_TRACKER=jira
# Preferred: fetch this from a vault instead of the plaintext value below —
# JIRA_TOKEN_CMD="rbw get spindrift-jira-token" (or an op/pass/vault
# read); the command's stdout wins over JIRA_TOKEN and is never baked,
# logged, or written to disk.
JIRA_TOKEN=

# Mistral API key for the pi Driver's mistral Provider; required when DRIVER=pi and any model tier is mistral/<model>; forwarded into every Box when set, whatever the Driver
# Preferred: fetch this from a vault instead of the plaintext value below —
# MISTRAL_API_KEY_CMD="rbw get spindrift-mistral-api-key" (or an op/pass/vault
# read); the command's stdout wins over MISTRAL_API_KEY and is never baked,
# logged, or written to disk.
MISTRAL_API_KEY=

# OpenAI API key for the pi Driver's openai Provider; required when DRIVER=pi and any model tier is openai/<model>; forwarded into every Box when set, whatever the Driver
# Preferred: fetch this from a vault instead of the plaintext value below —
# OPENAI_API_KEY_CMD="rbw get spindrift-openai-api-key" (or an op/pass/vault
# read); the command's stdout wins over OPENAI_API_KEY and is never baked,
# logged, or written to disk.
OPENAI_API_KEY=

# opencode github-copilot Provider auth store (JSON) — the whole auth slice opencode reads natively (ADR 0009 amendment, #260); the github-copilot Provider is OAuth-only. Mint once on a host with 'opencode auth login -p github-copilot', then export the github-copilot slice of ~/.local/share/opencode/auth.json (exact jq recipe in docs/reference.md). Required when DRIVER=opencode and any model tier (MODEL, REVIEW_MODEL, WORKER_MODEL, SCOUT_MODEL, FILER_MODEL) is github-copilot/<model>; ignored under the claude Driver
# Preferred: fetch this from a vault instead of the plaintext value below —
# OPENCODE_AUTH_CONTENT_CMD="rbw get spindrift-opencode-auth-content" (or an op/pass/vault
# read); the command's stdout wins over OPENCODE_AUTH_CONTENT and is never baked,
# logged, or written to disk.
OPENCODE_AUTH_CONTENT=

# OpenRouter API key for the pi Driver's openrouter Provider; required when DRIVER=pi and any model tier is openrouter/<model>; forwarded into every Box when set, whatever the Driver
# Preferred: fetch this from a vault instead of the plaintext value below —
# OPENROUTER_API_KEY_CMD="rbw get spindrift-openrouter-api-key" (or an op/pass/vault
# read); the command's stdout wins over OPENROUTER_API_KEY and is never baked,
# logged, or written to disk.
OPENROUTER_API_KEY=

# xAI API key for the pi Driver's xai Provider; required when DRIVER=pi and any model tier is xai/<model>; forwarded into every Box when set, whatever the Driver
# Preferred: fetch this from a vault instead of the plaintext value below —
# XAI_API_KEY_CMD="rbw get spindrift-xai-api-key" (or an op/pass/vault
# read); the command's stdout wins over XAI_API_KEY and is never baked,
# logged, or written to disk.
XAI_API_KEY=

