{
  "forgejo": {
    "credentialEnv": "FORGEJO_TOKEN",
    "credentialScheme": "bearer",
    "baseEnv": "FORGEJO_BASE_URL",
    "gitRemoteEnv": "FORGEJO_BASE_URL",
    "routes": [
      {"method":"GET","host":"{base}","path":"/api/v1/repos/{repo}/actions/jobs/*/logs","followRedirect":true},
      {"method":"GET","host":"{base}","path":"/api/v1/repos/{repo}","responseHeaders":["X-Total-Count"]},
      {"method":"POST","host":"{base}","path":"/api/v1/repos/{repo}/pulls"},
      {"method":"PATCH","host":"{base}","path":"/api/v1/repos/{repo}/pulls"},
      {"method":"POST","host":"{base}","path":"/api/v1/repos/{repo}/issues"},
      {"method":"DELETE","host":"{base}","path":"/api/v1/repos/{repo}/branches"},
      {"method":"PUT","host":"{base}","path":"/api/v1/repos/{repo}/issues"},
      {"method":"PATCH","host":"{base}","path":"/api/v1/repos/{repo}/issues"},
      {"method":"POST","host":"{base}","path":"/api/v1/repos/{repo}/labels"},
      {"method":"GET","host":"{base}","path":"/api/v1/orgs"}
    ]
  },
  "github": {
    "credentialEnv": "GH_TOKEN",
    "credentialScheme": "bearer",
    "gitRemote": "https://github.com",
    "routes": [
      {"method":"GET","host":"api.github.com","path":"/repos/{repo}/issues","requestHeaders":["X-GitHub-Api-Version"]},
      {"method":"GET","host":"api.github.com","path":"/repos/{repo}/pulls","requestHeaders":["X-GitHub-Api-Version"]},
      {"method":"POST","host":"api.github.com","path":"/graphql","requestHeaders":["X-GitHub-Api-Version"],"responseHeaders":["X-OAuth-Scopes"],"documents":{"closeIssue":"mutation($id:ID!){closeIssue(input:{issueId:$id,stateReason:COMPLETED}){clientMutationId}}","comments":"query($owner:String!,$repo:String!,$number:Int!,$after:String){repository(owner:$owner,name:$repo){issue(number:$number){comments(first:100,after:$after){pageInfo{hasNextPage endCursor} nodes{author{login} createdAt body isMinimized minimizedReason authorAssociation}}}}}","convertToDraft":"mutation($id:ID!){convertPullRequestToDraft(input:{pullRequestId:$id}){clientMutationId}}","enableAutoMerge":"mutation($id:ID!){enablePullRequestAutoMerge(input:{pullRequestId:$id,mergeMethod:REBASE}){clientMutationId}}","issueID":"query($owner:String!,$repo:String!,$number:Int!){repository(owner:$owner,name:$repo){issue(number:$number){id}}}","labelID":"query($owner:String!,$repo:String!,$number:Int!,$name:String!){repository(owner:$owner,name:$repo){issue(number:$number){id} label(name:$name){id}}}","markReadyForReview":"mutation($id:ID!){markPullRequestReadyForReview(input:{pullRequestId:$id}){clientMutationId}}","removeLabels":"mutation($id:ID!,$ids:[ID!]!){removeLabelsFromLabelable(input:{labelableId:$id,labelIds:$ids}){clientMutationId}}","repository":"query($owner:String!,$repo:String!){repository(owner:$owner,name:$repo){nameWithOwner autoMergeAllowed}}","rollup":"query($owner:String!,$repo:String!,$number:Int!){repository(owner:$owner,name:$repo){pullRequest(number:$number){url commits(last:1){nodes{commit{statusCheckRollup{state contexts(first:50){nodes{__typename ... on CheckRun{name conclusion status summary detailsUrl} ... on StatusContext{context state description}}}}}}}}}}","viewer":"{viewer{login}}"}},
      {"method":"GET","host":"api.github.com","path":"/repos/{repo}/actions/jobs/*/logs","followRedirect":true,"requestHeaders":["X-GitHub-Api-Version"]},
      {"method":"POST","host":"api.github.com","path":"/repos/{repo}/actions/runs/*/rerun-failed-jobs","requestHeaders":["X-GitHub-Api-Version"]},
      {"method":"POST","host":"api.github.com","path":"/repos/{repo}/pulls","requestHeaders":["X-GitHub-Api-Version"]},
      {"method":"PUT","host":"api.github.com","path":"/repos/{repo}/pulls","requestHeaders":["X-GitHub-Api-Version"]},
      {"method":"POST","host":"api.github.com","path":"/repos/{repo}/issues","requestHeaders":["X-GitHub-Api-Version"]},
      {"method":"GET","host":"api.github.com","path":"/repos/{repo}/compare","requestHeaders":["X-GitHub-Api-Version"]},
      {"method":"GET","host":"api.github.com","path":"/repos/{repo}/git/matching-refs/heads","requestHeaders":["X-GitHub-Api-Version"]},
      {"method":"DELETE","host":"api.github.com","path":"/repos/{repo}/git/refs/heads","requestHeaders":["X-GitHub-Api-Version"]},
      {"method":"GET","host":"api.github.com","path":"/repos/{repo}/branches","requestHeaders":["X-GitHub-Api-Version"]},
      {"method":"GET","host":"api.github.com","path":"/repos/{repo}/rules/branches","requestHeaders":["X-GitHub-Api-Version"]},
      {"method":"GET","host":"api.github.com","path":"/repos/{repo}/labels","requestHeaders":["X-GitHub-Api-Version"]},
      {"method":"POST","host":"api.github.com","path":"/repos/{repo}/labels","requestHeaders":["X-GitHub-Api-Version"]},
      {"method":"GET","host":"api.github.com","path":"/installation/repositories","requestHeaders":["X-GitHub-Api-Version"]},
      {"method":"GET","host":"api.github.com","path":"/search/issues","requestHeaders":["X-GitHub-Api-Version"]}
    ]
  },
  "jira": {
    "credentialEnv": "JIRA_TOKEN",
    "credentialScheme": "basic",
    "baseEnv": "JIRA_BASE_URL",
    "routes": [
      {"method":"GET","host":"{base}","path":"/rest/api/2/search"},
      {"method":"GET","host":"{base}","path":"/rest/api/2/issue"},
      {"method":"PUT","host":"{base}","path":"/rest/api/2/issue"},
      {"method":"POST","host":"{base}","path":"/rest/api/2/issue"},
      {"method":"GET","host":"{base}","path":"/rest/api/2/label"},
      {"method":"GET","host":"{base}","path":"/rest/api/2/myself"},
      {"method":"GET","host":"{base}","path":"/rest/api/2/project/{repo}/statuses"},
      {"method":"POST","host":"{base}","path":"/rest/api/3/search/approximate-count"}
    ]
  }
}
