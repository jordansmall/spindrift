{
  "forgejo": [
    { "method": "GET", "host": "{base}", "path": "/api/v1/repos/{repo}/pulls" },
    { "method": "GET", "host": "{base}", "path": "/api/v1/repos/{repo}/commits" },
    { "method": "GET", "host": "{base}", "path": "/api/v1/repos/{repo}/branches" },
    { "method": "DELETE", "host": "{base}", "path": "/api/v1/repos/{repo}/branches" }
  ],
  "github": [
    { "method": "GET", "host": "api.github.com", "path": "/repos/{repo}/issues" },
    { "method": "GET", "host": "api.github.com", "path": "/repos/{repo}/pulls" },
    { "method": "POST", "host": "api.github.com", "path": "/graphql" },
    { "method": "GET", "host": "api.github.com", "path": "/search/issues" }
  ],
  "jira": [
    { "method": "GET", "host": "{base}", "path": "/rest/api/2/search" },
    { "method": "GET", "host": "{base}", "path": "/rest/api/2/issue" }
  ]
