{{define "reason"}}
  {{- if .Halted}}
  <section class="banner halted">
    <strong>Pool halted</strong>
    <p class="reason">{{if .Reason}}{{.Reason}}{{else}}no reason published{{end}}</p>
  </section>
  {{- else if .Reason}}
  <section class="banner note"><p class="reason">{{.Reason}}</p></section>
  {{- end}}
{{- end -}}
{{define "published"}}<div><span class="label">published</span><time>{{.Written}}</time></div>{{end -}}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Spindrift Dashboard</title>
<link rel="stylesheet" href="/static/style.css">
</head>
<body>
<header class="top">
  <h1>Spindrift Daemon</h1>
{{- if .Live}}
  <span class="pill state-{{.State}}">{{.State}}</span>
{{- end}}
</header>
<main>
{{- if .Errored}}
  <section class="banner error">
    <strong>The status file could not be read.</strong>
    <p>{{.Err}}</p>
    {{- if .Raw}}<pre class="raw">{{.Raw}}</pre>{{end}}
  </section>
{{- else if .None}}
  <section class="banner none">
    <strong>no Daemon running</strong>
    {{- if .Note}}<p>{{.Note}}</p>{{end}}
  </section>
  {{- if .State}}
  <section class="facts">
    <div><span class="label">last state</span><span>{{.State}}</span></div>
    {{template "published" .}}
  </section>
  {{- template "reason" .}}
  {{- end}}
{{- else}}
  {{- template "reason" .}}
  <section class="facts">
    <div><span class="label">host</span><span>{{.Host}}</span></div>
    <div><span class="label">pid</span><span>{{.Pid}}</span></div>
    <div><span class="label">uptime</span><span>{{.Uptime}}</span></div>
    <div><span class="label">slots</span><span>{{.Busy}}/{{.Total}} busy</span></div>
    {{template "published" .}}
  </section>

  {{- if .Kinds}}
  <h2>Kinds</h2>
  <section class="grid kinds">
    {{- range .Kinds}}
    <article class="kind{{if .Jammed}} jammed{{end}}">
      <h3>{{.Kind}}{{if .Jammed}} <span class="tag jam">jammed</span>{{end}}</h3>
      <dl>
        <dt>next check</dt><dd>{{if .NextCheck}}<time>{{.NextCheck}}</time>{{else if .OnTipMove}}on tip move{{else}}runnable now{{end}}</dd>
        {{- if .JamUntil}}<dt>jam until</dt><dd><time>{{.JamUntil}}</time></dd>{{end}}
        {{- if .ReadyAtJam}}<dt>ready at jam</dt><dd>{{.ReadyAtJam}}</dd>{{end}}
        {{- if .Ready}}<dt>demand ready</dt><dd>{{.Ready}}</dd>{{end}}
        {{- if .ProbedAt}}<dt>probed at</dt><dd><time>{{.ProbedAt}}</time></dd>{{end}}
        {{- if .NextProbe}}<dt>next probe</dt><dd><time>{{.NextProbe}}</time></dd>{{end}}
        {{- if .NextDue}}<dt>next due</dt><dd>{{if .OnTipMove}}on tip move{{else}}<time>{{.NextDue}}</time>{{if .AlsoTipMove}} (or earlier on tip move){{end}}{{end}}</dd>{{end}}
      </dl>
    </article>
    {{- end}}
  </section>
  {{- end}}

  {{- if .Trackers}}
  <h2>Trackers</h2>
  <section class="trackers">
    {{- range .Trackers}}
    <div class="tracker">{{.Tracker}}:
      {{if .RateLimitedUntil}}<span class="tag jam">rate limited until <time>{{.RateLimitedUntil}}</time></span>{{else}}ok{{end}}
    </div>
    {{- end}}
  </section>
  {{- end}}

  <h2>Slots</h2>
  <section class="grid slots">
    {{- range .Slots}}
    <article class="card phase-{{.Phase}}">
      <header>
        <span class="slotno">slot {{.Slot}}</span>
        <span class="pill phase-{{.Phase}}">{{.Phase}}</span>
      </header>
      {{- if .Kind}}<div class="kindname">{{.Kind}}</div>{{end}}
      {{- if .Subject}}<div class="subject">{{range $i, $s := .Subject}}{{if $i}} {{end}}<span class="chip">{{$s}}</span>{{end}}</div>{{end}}
      {{- if .Rev}}<div class="rev"><code>{{.Rev}}</code></div>{{end}}
      <div class="inphase"><span class="label">in phase</span> <span>{{.Elapsed}}</span></div>
    </article>
    {{- else}}
    <p class="muted">The Daemon published no slots.</p>
    {{- end}}
  </section>
{{- end}}
</main>
</body>
</html>
