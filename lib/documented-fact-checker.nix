# The one marker-splice and drift-comparison implementation for every check
# that compares a committed file's BEGIN/END-marker-delimited span against
# generated Nix source of truth (issue #2949). nix/checks/schema-drift.nix,
# nix/checks/baked-skills.nix, and nix/regen.nix import this instead of
# hand-mirroring three copies that could drift apart.

# Marker convention (matches lib/documented-facts.nix and
# lib/documented-fact-shape.nix): beginMarker carries its own trailing "\n",
# endMarker carries none.
{ pkgs }:
rec {
  # Isolates the text strictly between a begin/end marker line pair inside
  # docSrc, else throws naming docPath and blockName. Each marker must be a
  # whole line occurring exactly once, begin before end: the same condition
  # spliceShellFn's awk enforces, so a marker this guard accepts is one the
  # splice finds. Lines are compared literally, so markers holding regex
  # metacharacters need no escaping (issue #2948).
  splitMarkedBlock =
    {
      blockName,
      beginMarker,
      endMarker,
      docSrc,
      docPath,
    }:
    let
      inherit (pkgs.lib)
        concatMapStrings
        imap0
        filter
        removeSuffix
        sublist
        splitString
        ;
      lines = splitString "\n" docSrc;
      indicesOf = marker: filter (i: i != null) (imap0 (i: l: if l == marker then i else null) lines);
      locate =
        kind: marker:
        let
          found = indicesOf marker;
        in
        if found == [ ] then
          throw "${docPath}: ${kind} GENERATED ${blockName} marker not found"
        else if builtins.length found > 1 then
          throw "${docPath}: ${kind} GENERATED ${blockName} marker must appear exactly once as a whole line (found ${toString (builtins.length found)})"
        else
          builtins.head found;
      begin = locate "BEGIN" (removeSuffix "\n" beginMarker);
      end = locate "END" endMarker;
    in
    if end < begin then
      throw "${docPath}: END GENERATED ${blockName} marker precedes its BEGIN marker"
    else
      concatMapStrings (l: l + "\n") (sublist (begin + 1) (end - begin - 1) lines);

  assertMarkedBlockOk =
    {
      blockName,
      sourceDesc,
      beginMarker,
      endMarker,
      docSrc,
      generated,
      docPath,
    }:
    let
      inherit (pkgs.lib) assertMsg;
      committed = splitMarkedBlock {
        inherit
          blockName
          beginMarker
          endMarker
          docSrc
          docPath
          ;
      };
    in
    assert assertMsg (committed == generated) ''
      ${docPath} generated ${blockName} sub-block is out of sync with ${sourceDesc} — regenerate it with `nix run .#regen`
        got:  ${committed}
        want: ${generated}'';
    docSrc;

  # The awk keeps both marker lines and replaces only the text between them.
  # Markers match whole lines, so a re-indented marker matches nothing: splice
  # fails unless begin occurs exactly once with exactly one end after it, rather
  # than passing the input through (stale span) or skipping to EOF (truncation).
  spliceShellFn = ''
    splice() {
      local committed="$1" beginMarker="$2" endMarker="$3" rawfile="$4" outfile="$5"
      awk -v begin="$beginMarker" -v end="$endMarker" -v rawfile="$rawfile" -v committed="$committed" '
        BEGIN { while ((getline line < rawfile) > 0) content = content line "\n" }
        $0 == begin { nb++; print; printf "%s", content; skip=1; next }
        $0 == end { ne++; if (!skip) stray=1; skip=0 }
        skip { next }
        { print }
        END {
          if (nb != 1 || ne != 1 || stray) {
            printf "splice: %s: want begin marker exactly once and one end marker after it, got %d begin / %d end, end-before-begin=%d (begin: \"%s\", end: \"%s\")\n", committed, nb, ne, stray, begin, end > "/dev/stderr"
            exit 1
          }
        }
      ' "$committed" > "$outfile" || { rm -f "$outfile"; return 1; }
    }
  '';

  # Diffs a spliced reconstruction rather than the raw generated string: a
  # formatter may reflow the whole surrounding construct (gofmt aligning a Go
  # const block), so the committed span never matches generated byte for byte.
  assertSplicedSpanOk =
    {
      name,
      file,
      blockName,
      sourceDesc,
      beginMarker,
      endMarker,
      generated,
      # When true, runs `gofmt -w` over the reconstruction and folds pkgs.go
      # into nativeBuildInputs, since every call site that needs one wants both.
      gofmt ? false,
      nativeBuildInputs ? [ ],
      # Inverts the final diff: the build passes only when the reconstruction
      # does NOT match the committed file. Lets documented-fact-guard drive
      # this function's real rejection path against a synthetic drift instead
      # of only its happy path (issue #2949 review finding).
      expectMismatch ? false,
    }:
    let
      inherit (pkgs.lib)
        assertMsg
        hasPrefix
        removePrefix
        removeSuffix
        ;
      # Repo-relative, not `toString file`: that is a path inside the flake-source
      # store copy, whose hash covers the whole tree and would move this drv on
      # any unrelated edit.
      repoPrefix = "${toString ../.}/";
      displayPath =
        assert assertMsg (hasPrefix repoPrefix (
          toString file
        )) "documented-fact-checker: ${toString file} is outside the repo root";
        removePrefix repoPrefix (toString file);
      raw = pkgs.writeText "${name}.raw" generated;
      beginLine = removeSuffix "\n" beginMarker;
      markersPresent = splitMarkedBlock {
        inherit blockName beginMarker endMarker;
        docSrc = builtins.readFile file;
        docPath = displayPath;
      };
      postProcessStep = if gofmt then "gofmt -w reconstructed" else "";
      effectiveNativeBuildInputs = nativeBuildInputs ++ (if gofmt then [ pkgs.go ] else [ ]);
      diffStep =
        if expectMismatch then
          ''
            if diff reconstructed "$committed" >/dev/null; then
              echo "${name}: expected the reconstructed span to differ from the committed file (synthetic drift), but it matched -- assertSplicedSpanOk's rejection path is not actually catching drift" >&2
              exit 1
            else
              touch $out
            fi
          ''
        else
          ''
            diff reconstructed "$committed" \
              || { echo "${displayPath} generated ${blockName} span is out of sync with ${sourceDesc} -- regenerate it with \`nix run .#regen\`" >&2; exit 1; }
            touch $out
          '';
    in
    # Forcing markersPresent proves each marker is a whole line occurring once,
    # so the awk splice cannot fall through silently and let the diff below
    # report no drift.
    builtins.seq markersPresent (
      pkgs.runCommand name
        {
          nativeBuildInputs = effectiveNativeBuildInputs;
          committed = file;
          inherit raw;
          beginMarker = beginLine;
          inherit endMarker;
        }
        ''
          ${spliceShellFn}
          splice "$committed" "$beginMarker" "$endMarker" "$raw" reconstructed
          ${postProcessStep}
          ${diffStep}
        ''
    );
}
