# shellcheck shell=bash disable=SC2034 # CREDENTIAL_VARS is read by the sourcing hook
# Sourced by env-credential-scrub.sh and bash-output-tee.sh (issue #5373), so
# both parse the credential list the same way. Sets CREDENTIAL_VARS empty when
# the list is missing or names nothing; each hook turns that into its own
# fail-closed response. CREDENTIAL_VARS_FILE overrides the sibling list path.
CREDENTIAL_VARS_FILE="${CREDENTIAL_VARS_FILE:-$(dirname "${BASH_SOURCE[0]}")/credential-vars}"
CREDENTIAL_VARS="$(grep -vE '^[[:space:]]*(#|$)' "$CREDENTIAL_VARS_FILE" 2>/dev/null | tr '\n' ' ' | sed 's/ *$//' || true)"
