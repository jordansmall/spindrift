<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="artifactory" value="https://artifactory.example.test/artifactory/api/nuget/v3/nuget-local/index.json" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceCredentials>
    <artifactory>
      <add key="Username" value="synth" />
      <add key="ClearTextPassword" value="not-a-secret" />
    </artifactory>
    <nuget.org>
      <add key="Username" value="synth" />
    </nuget.org>
  </packageSourceCredentials>
  <packageSourceMapping>
    <packageSource key="artifactory">
      <package pattern="*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="Microsoft.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
