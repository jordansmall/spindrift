# Preferred: source each secret below from a vault via its <NAME>_CMD
# form rather than the plaintext value — harness.env then holds
# fetch recipes, not live credentials.
# One vault, uniform naming? SECRET_CMD sets a single templated fetch
# command (e.g. "rbw get spindrift-{name}") for any secret without a
# <NAME>_CMD, but note the plaintext value below still wins over it
# too, so remove that value (or add <NAME>_CMD) for SECRET_CMD to apply.

# Jira backend (jira)

# Preferred: fetch this from a vault instead of the plaintext value below —
# JIRA_TOKEN_CMD="rbw get spindrift-jira-token" (or an op/pass/vault
# read); the command's stdout wins over JIRA_TOKEN and is never baked,
# logged, or written to disk.
JIRA_TOKEN=jira-faketoken

# The Connector authorizes its reads and writes with this token. A separate,
# least-privilege token may replace it: see docs/reference.md#backend-primary-mode.
# Preferred: fetch this from a vault instead of the plaintext value below —
# SPINDRIFT_JIRA_CONNECTOR_TOKEN_CMD="rbw get spindrift-spindrift-jira-connector-token" (or an op/pass/vault
# read); the command's stdout wins over SPINDRIFT_JIRA_CONNECTOR_TOKEN and is never baked,
# logged, or written to disk.
SPINDRIFT_JIRA_CONNECTOR_TOKEN=jira-faketoken

SPINDRIFT_JIRA_CONNECTOR_EMAIL=

# GitHub backend (github)

# Preferred: fetch this from a vault instead of the plaintext value below —
# GH_TOKEN_CMD="rbw get spindrift-gh-token" (or an op/pass/vault
# read); the command's stdout wins over GH_TOKEN and is never baked,
# logged, or written to disk.
GH_TOKEN=ghp_faketoken

# The Connector authorizes its reads and writes with this token. A separate,
# least-privilege token may replace it: see docs/reference.md#backend-primary-mode.
# Preferred: fetch this from a vault instead of the plaintext value below —
# SPINDRIFT_GITHUB_CONNECTOR_TOKEN_CMD="rbw get spindrift-spindrift-github-connector-token" (or an op/pass/vault
# read); the command's stdout wins over SPINDRIFT_GITHUB_CONNECTOR_TOKEN and is never baked,
# logged, or written to disk.
SPINDRIFT_GITHUB_CONNECTOR_TOKEN=ghp_faketoken

# Preferred: fetch this from a vault instead of the plaintext value below —
# CLAUDE_CODE_OAUTH_TOKEN_CMD="rbw get spindrift-claude-code-oauth-token" (or an op/pass/vault
# read); the command's stdout wins over CLAUDE_CODE_OAUTH_TOKEN and is never baked,
# logged, or written to disk.
CLAUDE_CODE_OAUTH_TOKEN=claude-oauth-faketoken

